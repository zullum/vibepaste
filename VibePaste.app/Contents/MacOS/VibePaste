#!/Users/sanel.zulic/myprojects/whisper.cpp/vibepaste/venv/bin/python3
"""VibePaste Launcher - Direct Python execution for Input Monitoring"""

import os
import sys
from pathlib import Path

# Hardcoded project root - the app may be installed in /Applications
# but the source code lives in this directory
PROJECT_ROOT = Path("/Users/sanel.zulic/myprojects/whisper.cpp/vibepaste")

os.chdir(PROJECT_ROOT)
sys.path.insert(0, str(PROJECT_ROOT))

# Check if already running
import subprocess
result = subprocess.run(
    ["pgrep", "-f", "python.*menubar"],
    capture_output=True, text=True
)
my_pid = str(os.getpid())
running_pids = [p for p in result.stdout.strip().split('\n') if p and p != my_pid]

if running_pids:
    subprocess.run([
        "osascript", "-e",
        'display notification "VibePaste is already running!" with title "🎙️ VibePaste" sound name "Pop"'
    ])
    sys.exit(0)

# Redirect stdout/stderr to log file for debugging
log_file = PROJECT_ROOT / "vibepaste_debug.log"
sys.stdout = open(log_file, "a", buffering=1)
sys.stderr = sys.stdout

print(f"--- VibePaste Launcher Started ---")
print(f"PROJECT_ROOT: {PROJECT_ROOT}")
print(f"sys.executable: {sys.executable}")
print(f"os.getcwd: {os.getcwd()}")

# Run the menubar app
from src.menubar import main

try:
    main()
except Exception as e:
    print(f"CRITICAL ERROR: {e}")
    import traceback
    traceback.print_exc()
